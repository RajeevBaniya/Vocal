{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src",
    "app",
    "config",
    "hotkeys",
    "audio",
    "stt",
    "state",
    "ipc",
    "utils",
    "types",
    "../shared"
  ],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "../shared/**/*.test.ts"]
}
